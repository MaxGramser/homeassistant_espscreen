{
  "name": "esp-screens-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && rm -rf ../screen_manager/app/static/assets && vite build",
    "check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "esptool-js": "^0.6.1",
    "floating-vue": "^5.4.0",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.18",
    "vue-i18n": "^11.4.12"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.0.6"
  }
}
